<div class="table-wrap card">
    <table class="jobs">
        <thead>
            <tr>
                @foreach (var column in Columns)
                {
                    <th class="@column.CssClass" aria-sort="@AriaSort(column.Key)">
                        <button class="sort" @onclick="() => SortBy(column.Key)">
                            @column.Label <span class="sort-arrow">@Arrow(column.Key)</span>
                        </button>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var match in Sorted)
            {
                <tr @key="match.Id"
                    class="@(match.Id == SelectedId ? "selected" : null) @(match.Status == MatchStatus.New ? "is-new" : null)"
                    tabindex="0"
                    @onclick="() => OnSelect.InvokeAsync(match)"
                    @onkeydown="e => OnRowKeyAsync(e, match)">
                    <td class="num"><span class="score score-@ScoreBand(match.Score)">@match.Score</span></td>
                    <td class="title-cell">
                        <span class="job-title">@match.Job.Title</span>
                        @if (match.Status == MatchStatus.Interested)
                        {
                            <span class="star" title="Interested">★</span>
                        }
                    </td>
                    <td>@(match.Job.Company ?? "—")</td>
                    <td class="hide-sm">@(match.Job.City ?? "—")</td>
                    <td class="hide-sm nowrap">@(HasSalary(match.Job) ? JobFormat.Salary(match.Job) : "—")</td>
                    <td class="hide-sm">@JobFormat.Source(match.Job)</td>
                    <td class="hide-sm nowrap muted">@match.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private const int StrongScore = 75;
    private const int FairScore = 50;

    private enum SortKey { Score, Title, Company, City, Salary, Source, Added }

    private record Column(SortKey Key, string Label, string? CssClass = null);

    private static readonly Column[] Columns =
    [
        new(SortKey.Score, "Score", "num"),
        new(SortKey.Title, "Job"),
        new(SortKey.Company, "Company"),
        new(SortKey.City, "City", "hide-sm"),
        new(SortKey.Salary, "Salary", "hide-sm"),
        new(SortKey.Source, "Source", "hide-sm"),
        new(SortKey.Added, "Added", "hide-sm")
    ];

    [Parameter, EditorRequired]
    public List<MatchItem> Matches { get; set; } = [];

    [Parameter]
    public Guid? SelectedId { get; set; }

    [Parameter]
    public EventCallback<MatchItem> OnSelect { get; set; }

    private SortKey _sortKey = SortKey.Score;
    private bool _descending = true;

    private IEnumerable<MatchItem> Sorted
    {
        get
        {
            var ordered = _sortKey switch
            {
                SortKey.Title => Order(m => m.Job.Title),
                SortKey.Company => Order(m => m.Job.Company ?? string.Empty),
                SortKey.City => Order(m => m.Job.City ?? string.Empty),
                SortKey.Salary => Order(m => m.Job.SalaryMax ?? m.Job.SalaryMin ?? 0),
                SortKey.Source => Order(m => m.Job.Source),
                SortKey.Added => Order(m => m.CreatedAt),
                _ => Order(m => m.Score)
            };

            // Ties keep the best match first, whatever column is sorted.
            return ordered.ThenByDescending(m => m.Score);
        }
    }

    private IOrderedEnumerable<MatchItem> Order<TKey>(Func<MatchItem, TKey> key) =>
        _descending ? Matches.OrderByDescending(key) : Matches.OrderBy(key);

    private void SortBy(SortKey key)
    {
        if (_sortKey == key)
        {
            _descending = !_descending;
            return;
        }

        _sortKey = key;
        // Numbers and dates read best biggest/newest first; text reads best A→Z.
        _descending = key is SortKey.Score or SortKey.Salary or SortKey.Added;
    }

    private string Arrow(SortKey key) => _sortKey != key ? string.Empty : _descending ? "↓" : "↑";

    private string AriaSort(SortKey key) => _sortKey != key ? "none" : _descending ? "descending" : "ascending";

    private static bool HasSalary(JobItem job) => job.SalaryMin is not null || job.SalaryMax is not null;

    private static string ScoreBand(int score) => score switch
    {
        >= StrongScore => "high",
        >= FairScore => "mid",
        _ => "low"
    };

    private async Task OnRowKeyAsync(KeyboardEventArgs e, MatchItem match)
    {
        if (e.Key is "Enter" or " ")
        {
            await OnSelect.InvokeAsync(match);
        }
    }
}

@* Drawn on a 100×100 canvas, back to front: hair behind the head, shoulders, head, face, hair on top. *@
<svg class="person-avatar @Class" viewBox="0 0 100 100" width="@Size" height="@Size"
     role="img" aria-label="@(Label ?? $"Avatar: {_avatar.Name}")">
    @if (_avatar.Hair == AvatarCatalog.Hair.Long)
    {
        <path d="M26 48 C24 24 36 14 50 14 C64 14 76 24 74 48 L77 76 C68 81 32 81 23 76 Z" fill="@_avatar.HairColor" />
    }
    @if (_avatar.Hair == AvatarCatalog.Hair.Bun)
    {
        <circle cx="50" cy="15" r="9" fill="@_avatar.HairColor" />
    }

    <path d="M12 100 C12 80 28 71 50 71 C72 71 88 80 88 100 Z" fill="@_avatar.Shirt" />
    <path d="M40 72 L50 82 L60 72" fill="none" stroke="@_shirtShade" stroke-width="2.5" stroke-linejoin="round" />
    <rect x="43" y="56" width="14" height="17" rx="6" fill="@_skinShade" />

    <circle cx="29.5" cy="47" r="4.5" fill="@_avatar.Skin" />
    <circle cx="70.5" cy="47" r="4.5" fill="@_avatar.Skin" />
    <ellipse cx="50" cy="44" rx="20.5" ry="23" fill="@_avatar.Skin" />

    <path d="M37.5 39.5 Q42 37 46.5 39.5" fill="none" stroke="@_brow" stroke-width="2" stroke-linecap="round" />
    <path d="M53.5 39.5 Q58 37 62.5 39.5" fill="none" stroke="@_brow" stroke-width="2" stroke-linecap="round" />
    <circle cx="42" cy="46" r="2.3" fill="@Eye" />
    <circle cx="58" cy="46" r="2.3" fill="@Eye" />
    <path d="M44.5 55 Q50 59.5 55.5 55" fill="none" stroke="@_skinShade" stroke-width="2.2" stroke-linecap="round" />

    @switch (_avatar.Hair)
    {
        case AvatarCatalog.Hair.Short:
        case AvatarCatalog.Hair.Long:
        case AvatarCatalog.Hair.Bun:
            <path d="M29 44 C27 25 37 17 50 17 C63 17 73 25 71 44 C68 33 60 28.5 50 28.5 C40 28.5 32 33 29 44 Z" fill="@_avatar.HairColor" />
            break;
        case AvatarCatalog.Hair.Curly:
            <g fill="@_avatar.HairColor">
                <circle cx="31" cy="39" r="7" />
                <circle cx="35" cy="28" r="8" />
                <circle cx="44" cy="21.5" r="8.5" />
                <circle cx="56" cy="21.5" r="8.5" />
                <circle cx="65" cy="28" r="8" />
                <circle cx="69" cy="39" r="7" />
                <circle cx="50" cy="27" r="9" />
            </g>
            break;
        case AvatarCatalog.Hair.Cap:
            <path d="M29 39 C29 23 38 16 50 16 C62 16 71 23 71 39 Z" fill="@_avatar.HairColor" />
            <path d="M48 37 L82 37 C84 37 84 41.5 81 42 L48 41.5 Z" fill="@_hairShade" />
            <circle cx="50" cy="17" r="2.2" fill="@_hairShade" />
            break;
        default:
            break;
    }

    @if (_avatar.Glasses)
    {
        <g fill="none" stroke="@Lens" stroke-width="1.8">
            <circle cx="42" cy="46" r="6" />
            <circle cx="58" cy="46" r="6" />
            <path d="M48 46 L52 46" stroke-linecap="round" />
        </g>
    }
</svg>

@code {
    private const string Eye = "#1d1f2b";
    private const string Lens = "#2a2d3a";
    private const string BaldBrow = "#3a2a22";

    [Parameter]
    public int AvatarId { get; set; }

    [Parameter]
    public int Size { get; set; } = 48;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Label { get; set; }

    private AvatarCatalog.Avatar _avatar = AvatarCatalog.All[0];
    private string _skinShade = string.Empty;
    private string _shirtShade = string.Empty;
    private string _hairShade = string.Empty;
    private string _brow = string.Empty;

    protected override void OnParametersSet()
    {
        _avatar = AvatarCatalog.Get(AvatarId);
        _skinShade = AvatarCatalog.Shade(_avatar.Skin);
        _shirtShade = AvatarCatalog.Shade(_avatar.Shirt);
        _hairShade = AvatarCatalog.Shade(_avatar.HairColor);
        _brow = _avatar.Hair == AvatarCatalog.Hair.Bald ? BaldBrow : _avatar.HairColor;
    }
}

<svg class="pixel-avatar @Class" viewBox="-1 -1 @(AvatarCatalog.Width + 2) @(AvatarCatalog.Height + 1)"
     width="@Size" height="@(Size * (AvatarCatalog.Height + 1) / (AvatarCatalog.Width + 2))"
     shape-rendering="crispEdges" role="img" aria-label="@(Label ?? $"Avatar: {_avatar.Name}")">
    @foreach (var pixel in _pixels)
    {
        <rect x="@pixel.X" y="@pixel.Y" width="1" height="1" fill="@pixel.Color" />
    }
</svg>

@code {
    [Parameter]
    public int AvatarId { get; set; }

    [Parameter]
    public int Size { get; set; } = 48;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Label { get; set; }

    private AvatarCatalog.Avatar _avatar = AvatarCatalog.All[0];
    private IReadOnlyList<AvatarCatalog.Pixel> _pixels = [];

    protected override void OnParametersSet()
    {
        _avatar = AvatarCatalog.Get(AvatarId);
        _pixels = AvatarCatalog.Draw(_avatar);
    }
}

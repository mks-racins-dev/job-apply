@page "/profile"
@inject JobMagnetApiClient Api
@inject NavigationManager Navigation

<PageTitle>Profile · Job Magnet</PageTitle>

@if (_loading)
{
    <p class="muted">Loading profile…</p>
}
else if (_profile is null)
{
    <section class="card narrow">
        <h1>No profile yet</h1>
        <p class="muted">Upload your CV and we'll build one for you.</p>
        <a class="button primary" href="/cv">Upload CV</a>
    </section>
}
else
{
    <section class="card">
        <div class="card-head">
            <h1>Review your profile</h1>
            @if (_isConfirmed)
            {
                <span class="badge ok">Matching on</span>
            }
            else
            {
                <span class="badge warn">Not confirmed</span>
            }
        </div>
        <p class="muted">This is what we match jobs against. Fix anything we got wrong, then save to start matching.</p>

        <EditForm Model="_profile" FormName="profile" class="grid">
            <label class="span-2">
                Headline
                <InputText @bind-Value="_profile.Headline" />
            </label>

            <TagInput Label="Roles" @bind-Values="_profile.Roles" Placeholder="e.g. Backend developer" />
            <TagInput Label="Skills" @bind-Values="_profile.Skills" Placeholder="e.g. C#" />

            <label>
                Seniority
                <InputSelect @bind-Value="_profile.Seniority">
                    @foreach (var level in SeniorityLevels)
                    {
                        <option value="@level">@level</option>
                    }
                </InputSelect>
            </label>
            <label>
                Years of experience
                <InputNumber @bind-Value="_profile.YearsOfExperience" min="0" step="0.5" />
            </label>

            <TagInput Label="Languages" @bind-Values="_profile.Languages" Placeholder="lv, en, ru" />
            <label>
                Location
                <InputText @bind-Value="_profile.Location" />
            </label>

            <TagInput Label="Preferred cities" @bind-Values="_profile.Preferences.Cities" Placeholder="e.g. Rīga" />
            <label>
                Minimum salary (EUR / month, gross)
                <InputNumber @bind-Value="_profile.Preferences.SalaryMin" min="0" step="100" />
            </label>

            <label class="checkbox span-2">
                <InputCheckbox @bind-Value="_profile.Preferences.Remote" />
                Open to remote work
            </label>

            @if (_message is not null)
            {
                <p class="span-2 @(_isError ? "error" : "success")">@_message</p>
            }

            <div class="actions span-2">
                <a class="button" href="/cv">Upload a new CV</a>
                <button class="primary" type="button" @onclick="SaveAsync" disabled="@_saving">
                    @(_saving ? "Saving…" : _isConfirmed ? "Save changes" : "Save & start matching")
                </button>
            </div>
        </EditForm>
    </section>
}

@code {
    private static readonly string[] SeniorityLevels = ["intern", "junior", "mid", "senior", "lead"];

    private ProfileData? _profile;
    private bool _isConfirmed;
    private bool _loading = true;
    private bool _saving;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetProfileAsync();
        if (result is { IsSuccess: true, Value: { } response })
        {
            _profile = response.Data;
            _isConfirmed = response.IsConfirmed;
        }
        else if (result.StatusCode != StatusCodes.Status404NotFound)
        {
            _message = result.Error;
            _isError = true;
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;

        var wasConfirmed = _isConfirmed;
        var result = await Api.SaveProfileAsync(_profile!);
        _saving = false;

        if (!result.IsSuccess)
        {
            _message = result.Error;
            _isError = true;
            return;
        }

        _isConfirmed = true;
        if (!wasConfirmed)
        {
            Navigation.NavigateTo("/");
            return;
        }

        _message = "Saved. New matches will use the updated profile.";
        _isError = false;
    }
}

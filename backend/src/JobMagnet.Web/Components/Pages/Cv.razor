@page "/cv"
@inject JobMagnetApiClient Api
@inject NavigationManager Navigation

<PageTitle>Upload CV · Job Magnet</PageTitle>

<section class="card narrow">
    <h1>Upload your CV</h1>
    <p class="muted">PDF or DOCX, up to 10 MB. We read it once and build a profile you can review before matching starts.</p>

    <label class="dropzone @(_busy ? "busy" : null)">
        <InputFile OnChange="UploadAsync" accept=".pdf,.docx" disabled="@_busy" />
        @if (_busy)
        {
            <span class="spinner"></span>
            <span>Reading @_fileName… this can take up to a minute.</span>
        }
        else
        {
            <span class="dropzone-title">Choose a file</span>
            <span class="muted">or drop it here</span>
        }
    </label>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
</section>

@code {
    private bool _busy;
    private string? _fileName;
    private string? _error;

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _error = null;

        if (file.Size > JobMagnetApiClient.MaxCvBytes)
        {
            _error = "That file is larger than 10 MB.";
            return;
        }

        _busy = true;
        _fileName = file.Name;

        var result = await Api.UploadCvAsync(file, CancellationToken.None);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/profile");
            return;
        }

        _error = result.Error;
        _busy = false;
    }
}

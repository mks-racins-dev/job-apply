@page "/"
@implements IAsyncDisposable
@inject JobMagnetApiClient Api
@inject AuthSession Session
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage Storage
@inject NavigationManager Navigation

<PageTitle>@(_view == HomeView.Table ? "Your matches" : "Your orbit") · Job Magnet</PageTitle>

@switch (_state)
{
    case HomeState.Loading:
        <p class="muted">Loading…</p>
        break;

    case HomeState.NeedsCv:
        <section class="card narrow">
            <h1>Let's get jobs coming to you</h1>
            <p class="muted">Upload your CV once. We build a profile, and matching jobs from visidarbi.lv, cv.lv and ss.lv start orbiting you.</p>
            <a class="button primary" href="/cv">Upload CV</a>
        </section>
        break;

    case HomeState.NeedsConfirmation:
        <section class="card narrow">
            <h1>One more step</h1>
            <p class="muted">Review the profile we built from your CV. Matching starts once you save it.</p>
            <a class="button primary" href="/profile">Review profile</a>
        </section>
        break;

    case HomeState.Error:
        <section class="card narrow">
            <p class="error">@_error</p>
            <button @onclick="RetryAsync">Try again</button>
        </section>
        break;

    default:
        <div class="home">
            <div class="home-main">
                <div class="toolbar">
                    <div>
                        <h1>@(_view == HomeView.Table ? "Your matches" : "Your orbit")</h1>
                        <p class="muted">@SummaryText</p>
                    </div>
                    <div class="view-switch" role="group" aria-label="View">
                        <button class="@(_view == HomeView.Orbit ? "active" : null)" aria-pressed="@(_view == HomeView.Orbit)"
                                @onclick="() => SetViewAsync(HomeView.Orbit)">◎ Orbit</button>
                        <button class="@(_view == HomeView.Table ? "active" : null)" aria-pressed="@(_view == HomeView.Table)"
                                @onclick="() => SetViewAsync(HomeView.Table)">☰ Table</button>
                    </div>
                    <label class="slider">
                        Min score <strong>@_minScore</strong>
                        <input type="range" min="0" max="90" step="10" value="@_minScore" @onchange="OnMinScoreChanged" />
                    </label>
                </div>

                @if (_matches.Count == 0)
                {
                    <div class="empty card">
                        <p>@(_page > 1 ? $"Page {_page} is empty." : $"No matches above {_minScore} yet.")</p>
                        <p class="muted">The worker scrapes and scores new jobs every 2 hours. This page refreshes on its own.</p>
                        @if (_page > 1)
                        {
                            <button @onclick="() => OnPage(1)">Go to page 1</button>
                        }
                    </div>
                }
                else if (_view == HomeView.Table)
                {
                    <JobTable Matches="_matches" Sort="@_sort" Descending="_descending" SelectedId="_selected?.Id"
                              OnSelect="SelectAsync" OnSort="OnSort" />
                    <Pager Page="_page" PageSize="_pageSize" Total="_total" OnPage="OnPage" OnPageSize="OnPageSize" />
                }
                else
                {
                    <JobOrbit Matches="_matches" MinScore="_minScore" SelectedId="_selected?.Id"
                              Email="@Session.Email" OnSelect="SelectAsync" />
                }
            </div>

            @if (_selected is not null)
            {
                <JobDetails Match="_selected" OnClose="() => _selected = null" OnStatus="SetStatusAsync" />
            }
        </div>
        break;
}

@code {
    private const int DefaultMinScore = 50;
    private const int MaxScore = 100;
    private const int DefaultPageSize = 25;
    private const int OrbitSize = 100;
    private const string ViewStorageKey = "jobmagnet.view";
    private const string TableViewValue = "table";
    private const string OrbitViewValue = "orbit";
    private const string AscendingValue = "asc";
    private const string DescendingValue = "desc";

    // Stands in for push notifications on the web: new matches drift in without a reload.
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromMinutes(1);

    // The URL is the source of truth for what is shown, so views and pages can be bookmarked and shared.
    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewParam { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageParam { get; set; }

    [SupplyParameterFromQuery(Name = "size")]
    public int? SizeParam { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortParam { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    public string? DirParam { get; set; }

    [SupplyParameterFromQuery(Name = "minScore")]
    public int? MinScoreParam { get; set; }

    // Set by "Add job" so the new job is opened right away.
    [SupplyParameterFromQuery(Name = "match")]
    public Guid? FocusMatchId { get; set; }

    private enum HomeState { Loading, NeedsCv, NeedsConfirmation, Ready, Error }

    private enum HomeView { Orbit, Table }

    private readonly CancellationTokenSource _cts = new();
    private HomeState _state = HomeState.Loading;
    private HomeView? _storedView;
    private HomeView _view = HomeView.Orbit;
    private List<MatchItem> _matches = [];
    private MatchItem? _selected;
    private Guid? _focusedId;
    private int _minScore = DefaultMinScore;
    private int _page = 1;
    private int _pageSize = DefaultPageSize;
    private string _sort = JobTable.ScoreKey;
    private bool _descending = true;
    private int _total;
    private int _newCount;
    private string? _error;

    private string SummaryText
    {
        get
        {
            var total = $"{_total} job{(_total == 1 ? "" : "s")} pulled in";
            return _newCount > 0 ? $"{total} · {_newCount} new" : total;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _storedView = await LoadStoredViewAsync();
        await LoadProfileStateAsync();

        // The user may have left (e.g. redirected to sign-in) while the profile was loading.
        if (!_cts.IsCancellationRequested)
        {
            _ = RefreshLoopAsync(_cts.Token);
        }
    }

    // Runs on first load and again every time the query string changes.
    protected override async Task OnParametersSetAsync()
    {
        ReadQuery();
        if (_state != HomeState.Ready)
        {
            return;
        }

        await LoadMatchesAsync();
        if (FocusMatchId is { } focusId && focusId != _focusedId)
        {
            _focusedId = focusId;
            if (_matches.FirstOrDefault(m => m.Id == focusId) is { } focused)
            {
                await SelectAsync(focused);
            }
        }
    }

    private void ReadQuery()
    {
        _view = ViewParam?.ToLowerInvariant() switch
        {
            TableViewValue => HomeView.Table,
            OrbitViewValue => HomeView.Orbit,
            _ => _storedView ?? HomeView.Orbit
        };
        _minScore = Math.Clamp(MinScoreParam ?? DefaultMinScore, 0, MaxScore);
        _page = Math.Max(PageParam ?? 1, 1);
        _pageSize = SizeParam is { } size && Pager.PageSizes.Contains(size) ? size : DefaultPageSize;
        _sort = JobTable.IsKnownSort(SortParam) ? SortParam! : JobTable.ScoreKey;
        _descending = DirParam?.ToLowerInvariant() switch
        {
            AscendingValue => false,
            DescendingValue => true,
            _ => JobTable.DefaultDescending(_sort)
        };
    }

    private async Task LoadProfileStateAsync()
    {
        var profile = await Api.GetProfileAsync();
        if (profile.StatusCode == StatusCodes.Status404NotFound)
        {
            _state = HomeState.NeedsCv;
            return;
        }

        if (profile is not { IsSuccess: true, Value: { } response })
        {
            _error = profile.Error;
            _state = HomeState.Error;
            return;
        }

        _state = response.IsConfirmed ? HomeState.Ready : HomeState.NeedsConfirmation;
    }

    private async Task RetryAsync()
    {
        _state = HomeState.Loading;
        await LoadProfileStateAsync();
        if (_state == HomeState.Ready)
        {
            await LoadMatchesAsync();
        }
    }

    private async Task LoadMatchesAsync()
    {
        // The orbit always shows the strongest matches; only the table pages and sorts.
        var query = _view == HomeView.Table
            ? new MatchQuery(_minScore, _page, _pageSize, _sort, _descending)
            : new MatchQuery(_minScore, 1, OrbitSize, JobTable.ScoreKey, Descending: true);

        var result = await Api.GetMatchesAsync(query);
        if (result is not { IsSuccess: true, Value: { } page })
        {
            _error = result.Error;
            _state = HomeState.Error;
            return;
        }

        _matches = page.Items;
        _total = page.Total;
        _newCount = page.NewCount;
        _selected = _selected is null ? null : _matches.FirstOrDefault(m => m.Id == _selected.Id);
        _state = HomeState.Ready;
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_state == HomeState.Ready)
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadMatchesAsync();
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Page closed.
        }
    }

    // Values equal to their defaults are left out of the URL to keep it short.
    private void UpdateQuery(
        HomeView? view = null, int? page = null, int? size = null, string? sort = null, bool? descending = null, int? minScore = null)
    {
        var nextView = view ?? _view;
        var nextSort = sort ?? _sort;
        var nextDescending = descending ?? _descending;
        var nextSize = size ?? _pageSize;
        var nextMinScore = minScore ?? _minScore;
        var nextPage = page ?? _page;
        var isTable = nextView == HomeView.Table;

        var parameters = new Dictionary<string, object?>
        {
            ["view"] = isTable ? TableViewValue : OrbitViewValue,
            ["page"] = isTable && nextPage > 1 ? nextPage : null,
            ["size"] = isTable && nextSize != DefaultPageSize ? nextSize : null,
            ["sort"] = isTable && nextSort != JobTable.ScoreKey ? nextSort : null,
            ["dir"] = isTable && nextDescending != JobTable.DefaultDescending(nextSort)
                ? (nextDescending ? DescendingValue : AscendingValue)
                : null,
            ["minScore"] = nextMinScore != DefaultMinScore ? nextMinScore : null,
            ["match"] = null
        };

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(parameters));
    }

    private async Task SetViewAsync(HomeView view)
    {
        _storedView = view;
        try
        {
            await Storage.SetAsync(ViewStorageKey, view.ToString());
        }
        catch (System.Security.Cryptography.CryptographicException)
        {
            // Only a preference; the URL still switches the view for this visit.
        }

        UpdateQuery(view: view, page: 1);
    }

    private async Task<HomeView?> LoadStoredViewAsync()
    {
        try
        {
            var stored = await Storage.GetAsync<string>(ViewStorageKey);
            return stored.Success && Enum.TryParse<HomeView>(stored.Value, out var view) ? view : null;
        }
        catch (System.Security.Cryptography.CryptographicException)
        {
            return null;
        }
    }

    private void OnMinScoreChanged(ChangeEventArgs e) =>
        UpdateQuery(minScore: int.TryParse(e.Value?.ToString(), out var value) ? value : DefaultMinScore, page: 1);

    private void OnSort((string Sort, bool Descending) order) => UpdateQuery(sort: order.Sort, descending: order.Descending, page: 1);

    private void OnPage(int page) => UpdateQuery(page: page);

    private void OnPageSize(int size) => UpdateQuery(size: size, page: 1);

    private async Task SelectAsync(MatchItem match)
    {
        _selected = match;
        if (match.Status == MatchStatus.New)
        {
            await SetStatusAsync(MatchStatus.Seen);
        }
    }

    private async Task SetStatusAsync(MatchStatus status)
    {
        if (_selected is not { } match)
        {
            return;
        }

        // Toggling Interested off returns the job to a plain seen state.
        var target = match.Status == MatchStatus.Interested && status == MatchStatus.Interested ? MatchStatus.Seen : status;
        var result = await Api.UpdateMatchStatusAsync(match.Id, target);
        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        if (match.Status == MatchStatus.New)
        {
            _newCount = Math.Max(_newCount - 1, 0);
        }

        if (target == MatchStatus.Dismissed)
        {
            _matches.Remove(match);
            _total = Math.Max(_total - 1, 0);
            _selected = null;
            return;
        }

        var updated = match with { Status = target };
        _matches[_matches.IndexOf(match)] = updated;
        _selected = updated;
    }

    // Cancel only: disposing would break initialization code that may still be awaiting.
    public async ValueTask DisposeAsync() => await _cts.CancelAsync();
}

<div class="field">
    <span class="field-label">@Label</span>
    <div class="tags">
        @foreach (var value in Values)
        {
            <span class="tag">
                @value
                <button type="button" aria-label="Remove @value" @onclick="() => RemoveAsync(value)">×</button>
            </span>
        }
        <input value="@_draft" placeholder="@Placeholder"
               @oninput="OnInputAsync" @onkeydown="OnKeyDownAsync" @onblur="CommitDraftAsync" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public List<string> Values { get; set; } = [];

    [Parameter]
    public EventCallback<List<string>> ValuesChanged { get; set; }

    private string _draft = string.Empty;

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        _draft = e.Value?.ToString() ?? string.Empty;
        if (_draft.Contains(','))
        {
            await CommitDraftAsync();
        }
    }

    // The profile form has no submit button, so Enter here only adds a tag.
    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CommitDraftAsync();
        }
        else if (e.Key == "Backspace" && _draft.Length == 0 && Values.Count > 0)
        {
            await RemoveAsync(Values[^1]);
        }
    }

    private async Task CommitDraftAsync()
    {
        var value = _draft.Trim().TrimEnd(',');
        _draft = string.Empty;
        if (value.Length == 0 || Values.Contains(value, StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        await ValuesChanged.InvokeAsync([.. Values, value]);
    }

    private Task RemoveAsync(string value) => ValuesChanged.InvokeAsync(Values.Where(v => v != value).ToList());
}

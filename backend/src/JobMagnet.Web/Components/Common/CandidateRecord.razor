<section class="panel profile-card" aria-labelledby="profile-card-title">
    <div class="profile-card-head">
        <span class="avatar-tile"><PersonAvatar AvatarId="AvatarId" Size="64" /></span>
        <div class="profile-card-id">
            <h2 id="profile-card-title">@FullName</h2>
            <p class="muted">@Headline</p>
        </div>
    </div>

    <dl class="list-rows">
        <div>
            <dt>Looking for</dt>
            <dd>@(Profile.InterestedRoles.Count == 0 ? "Roles like your experience" : string.Join(", ", Profile.InterestedRoles))</dd>
        </div>
        <div>
            <dt>Looking in</dt>
            <dd>@Looking</dd>
        </div>
        <div>
            <dt>Languages</dt>
            <dd>@(Profile.Languages.Count == 0 ? "Not set" : string.Join(", ", Profile.Languages.Select(l => $"{l.Language} ({l.Level})")))</dd>
        </div>
        <div>
            <dt>Salary from</dt>
            <dd>@(Profile.SalaryMin is { } min ? $"€{min:0} / mo" : "Open")</dd>
        </div>
        @if (Profile.DrivingLicences.Count > 0)
        {
            <div>
                <dt>Driving licence</dt>
                <dd>@string.Join(", ", Profile.DrivingLicences)</dd>
            </div>
        }
    </dl>

    @if (Profile.HardSkills.Count > 0)
    {
        <div class="chips">
            @foreach (var skill in Profile.HardSkills.Take(MaxSkills))
            {
                <span class="chip">@skill</span>
            }
            @if (Profile.HardSkills.Count > MaxSkills)
            {
                <span class="chip chip-quiet">+@(Profile.HardSkills.Count - MaxSkills)</span>
            }
        </div>
    }

    <a class="text-link" href="/profile">Edit profile</a>
</section>

@code {
    private const int MaxSkills = 8;

    [Parameter, EditorRequired]
    public ProfileData Profile { get; set; } = new();

    [Parameter]
    public int AvatarId { get; set; }

    private string FullName
    {
        get
        {
            var name = $"{Profile.FirstName} {Profile.LastName}".Trim();
            return name.Length == 0 ? "Your profile" : name;
        }
    }

    // The most relevant past role, or what they're heading for when they're new to work.
    private string Headline => Profile.Experience.FirstOrDefault() switch
    {
        { } latest => $"{latest.Role} · {Years(latest.Years)}",
        null when Profile.InterestedRoles.Count > 0 => $"Heading for {Profile.InterestedRoles[0]}",
        _ => "New to work"
    };

    private static string Years(decimal years) => years switch
    {
        <= 0 => "under a year",
        1 => "1 year",
        _ => $"{years:0.#} years"
    };

    private string Looking
    {
        get
        {
            var places = Profile.Cities.ToList();
            if (Profile.WorkModes.Contains("remote"))
            {
                places.Add("Remote");
            }

            return places.Count == 0 ? "Anywhere" : string.Join(", ", places);
        }
    }
}

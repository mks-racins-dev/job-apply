@inherits LayoutComponentBase
@implements IDisposable
@inject AuthSession Session
@inject JobMagnetApiClient Api
@inject NavigationManager Navigation

@if (_loaded)
{
    <header class="topbar">
        <a class="wordmark" href="/" aria-label="Job Magnet home">
            <span class="wordmark-glyph" aria-hidden="true"></span>Job Magnet
        </a>
        @if (Session.IsSignedIn)
        {
            <nav class="topnav" aria-label="Main">
                <NavLink href="/" Match="NavLinkMatch.All">Matches</NavLink>
                <NavLink href="/add-job">Add a job</NavLink>
            </nav>
            <AccountMenu />
        }
    </header>

    <main class="page">
        @Body
    </main>
}

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string LoginPath = "login";

    private bool _loaded;
    private bool _accountLoaded;

    protected override async Task OnInitializedAsync()
    {
        // Error and not-found pages render statically, where browser storage is unreachable.
        if (!RendererInfo.IsInteractive)
        {
            _loaded = true;
            return;
        }

        await Session.LoadAsync();
        await LoadAccountAsync();
        _loaded = true;
        Session.Changed += OnSessionChanged;
        Navigation.LocationChanged += OnLocationChanged;
        RedirectIfSignedOut();
    }

    // The avatar lives on the server so it follows the user across devices.
    private async Task LoadAccountAsync()
    {
        if (!Session.IsSignedIn || _accountLoaded)
        {
            return;
        }

        _accountLoaded = true;
        var account = await Api.GetAccountAsync();
        if (account is { IsSuccess: true, Value: { } info })
        {
            Session.SetAvatar(info.AvatarId);
        }
    }

    private void OnSessionChanged()
    {
        if (!Session.IsSignedIn)
        {
            _accountLoaded = false;
        }

        RedirectIfSignedOut();
        InvokeAsync(async () =>
        {
            await LoadAccountAsync();
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => RedirectIfSignedOut();

    private void RedirectIfSignedOut()
    {
        var onLogin = Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith(LoginPath, StringComparison.OrdinalIgnoreCase);
        if (!Session.IsSignedIn && !onLogin)
        {
            Navigation.NavigateTo(LoginPath);
        }
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
